# Installed into the live image. "#if ARCHITECTURES" blocks apply to amd64 (Intel/AMD PCs)
# or arm64 only (live-build conditionals). polyos-desktop and polyos-shell come from
# config/packages.chroot (copied there by `main.py iso`).
polyos-desktop

# Live system. The PolyOS installer (setup on the live USB) uses the tools below;
# Calamares stays as the "Advanced installer" for manual partitioning.
live-boot
live-config
live-config-systemd
calamares
calamares-settings-debian
sudo
user-setup
locales
keyboard-configuration

# PolyOS installer: partitioning, filesystems, copying the system, boot loaders
util-linux
dosfstools
e2fsprogs
ntfs-3g
squashfs-tools
os-prober
efibootmgr
mokutil
grub2-common
shim-signed
#if ARCHITECTURES amd64
grub-pc-bin
grub-efi-amd64-bin
grub-efi-amd64-signed
#endif
#if ARCHITECTURES arm64
grub-efi-arm64-bin
grub-efi-arm64-signed
#endif

# Driver Manager and PolyMarket
pciutils
usbutils
isenkram-cli
# firmware updates from the computer's maker (LVFS)
fwupd
flatpak
#if ARCHITECTURES amd64
nvidia-detect
#endif

# Coding basics on every PolyOS (Vara uses them too): git, Python's pip and venv, compilers
git
python3-pip
python3-venv
python3-dev
build-essential
curl
wget
jq

# Everyday apps and hardware (webcam for the Camera app, power modes, idle timers).
# Chromium runs the built-in cloud gaming services (GeForce NOW and Xbox need a Chromium browser).
evince
chromium
power-profiles-daemon
libxss1

# Security and speed on the installed system: firewall, automatic security updates,
# compressed RAM swap (zram), GameMode for the Gaming edition
ufw
unattended-upgrades
zram-tools
gamemode
gstreamer1.0-plugins-good
gstreamer1.0-libav
bluez
blueman

# Boot splash
plymouth
plymouth-label

# Hardware support
firmware-linux-free
firmware-linux-nonfree
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-libertas
firmware-sof-signed
#if ARCHITECTURES amd64
intel-microcode
amd64-microcode
#endif
